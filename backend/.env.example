# Adaptive Assessment System - Backend Configuration

# Application
APP_NAME="AI-Powered Adaptive Assessment System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (PostgreSQL with fallback to SQLite for local development)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/adaptive_assessment"
# To use SQLite directly, uncomment:
# DATABASE_URL="sqlite:///./adaptive_assessment.db"

# Security & JWT
JWT_SECRET_KEY="replace_this_with_a_super_secret_cryptographic_random_string"
JWT_ALGORITHM="HS256"
FACULTY_TOKEN_EXPIRE_MINUTES=30
STUDENT_TOKEN_EXPIRE_MINUTES=60

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
DEV_EXPOSE_OTP_IN_RESPONSE=True

# AI - Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

